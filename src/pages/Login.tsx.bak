
import { useEffect, useState, type FormEvent } from "react";
import { useLocation, useNavigate } from "react-router-dom";
import { useAuth } from "../auth/AuthContext";

type Mode = "login" | "register";

export default function Login() {
  const { login, register, isAuthenticated } = useAuth();
  const navigate = useNavigate();
  const location = useLocation();

  const [mode, setMode] = useState<Mode>("login");

  // 原有字段
  const [username, setUsername] = useState("");
  const [password, setPassword] = useState("");

  // 新增字段
  const [phone, setPhone] = useState("");
  const [email, setEmail] = useState("");

  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState("");
  const [isError, setIsError] = useState(false);

  useEffect(() => {
    if (isAuthenticated) {
      navigate("/", { replace: true });
    }
  }, [isAuthenticated, navigate]);

  // 切换登录 / 注册
  const switchMode = (nextMode: Mode) => {
    setMode(nextMode);
    setMessage("");
    setIsError(false);
  };

  // 提交表单
  const handleSubmit = async (e: FormEvent<HTMLFormElement>) => {
    e.preventDefault();

    setMessage("");
    setIsError(false);

    const cleanUsername = username.trim();
    const cleanPhone = phone.trim();
    const cleanEmail = email.trim();

    if (!cleanUsername || !password) {
      setMessage("请输入用户名和密码");
      setIsError(true);
      return;
    }

    // 注册时验证手机号和邮箱
    if (mode === "register") {
      if (!cleanPhone) {
        setMessage("请输入手机号");
        setIsError(true);
        return;
      }

      if (!/^1[3-9]\d{9}$/.test(cleanPhone)) {
        setMessage("请输入正确的中国大陆手机号");
        setIsError(true);
        return;
      }

      if (!cleanEmail) {
        setMessage("请输入邮箱");
        setIsError(true);
        return;
      }

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(cleanEmail)) {
        setMessage("请输入正确的邮箱地址");
        setIsError(true);
        return;
      }
    }

    setLoading(true);

    try {
      if (mode === "login") {
        await login({
          username: cleanUsername,
          password,
        });

        const from =
          (
            location.state as {
              from?: { pathname?: string };
            } | null
          )?.from?.pathname || "/";

        navigate(from, { replace: true });
      } else {
        // 当前接口仍按原有格式注册
        await register({
          username: cleanUsername,
          password,
        });

        setMode("login");
        setPassword("");
        setPhone("");
        setEmail("");

        setMessage("注册成功，请登录");
        setIsError(false);
      }
    } catch (error) {
      setMessage(
        error instanceof Error
          ? error.message
          : mode === "login"
            ? "登录失败"
            : "注册失败"
      );
      setIsError(true);
    } finally {
      setLoading(false);
    }
  };

  const inputClass =
    "w-full h-[55px] px-4 border border-[#b7c4ce] " +
    "bg-[#fbfcfd] text-[#30465a] text-sm " +
    "outline-none transition-all " +
    "placeholder:text-[#aeb8c0] " +
    "focus:border-[#607b92] focus:bg-white " +
    "disabled:opacity-60";

  const labelClass =
    "block mb-2 text-sm text-[#56697a]";

  return (
    <div className="min-h-screen flex items-center justify-center bg-[#eef2f5] px-4 py-8">
      <div className="w-full max-w-[600px] border border-[#aebdca] bg-[#f8fafb] shadow-xl">
        <div className="h-1 bg-[#405a72]" />

        <div className="px-7 py-10 sm:px-16">
          {/* 顶部标识 */}
          <div className="flex justify-center mb-5">
            <div className="w-14 h-14 flex items-center justify-center border border-[#8195a7] bg-[#e8eef3] text-[#405a72] text-3xl font-serif">
              萧
            </div>
          </div>

          <h1 className="text-center text-[28px] font-serif tracking-[0.15em] text-[#30465a]">
            萧与逸之恋
          </h1>

          <p className="mt-3 text-center text-xs tracking-widest text-[#81909e]">
            LOVE · MEMORY · TOGETHER
          </p>

          {/* 登录 / 注册切换 */}
          <div className="mt-9 flex border-b border-[#c7d1d9]">
            <button
              type="button"
              onClick={() => switchMode("login")}
              className={`flex-1 py-3 text-sm transition ${
                mode === "login"
                  ? "border-b-2 border-[#405a72] font-semibold text-[#304b64]"
                  : "text-[#9aa5af]"
              }`}
            >
              登录
            </button>

            <button
              type="button"
              onClick={() => switchMode("register")}
              className={`flex-1 py-3 text-sm transition ${
                mode === "register"
                  ? "border-b-2 border-[#405a72] font-semibold text-[#304b64]"
                  : "text-[#9aa5af]"
              }`}
            >
              注册
            </button>
          </div>

          <form onSubmit={handleSubmit} className="mt-7">
            {/* 用户名 */}
            <div className="mb-4">
              <label htmlFor="username" className={labelClass}>
                用户名
              </label>

              <input
                id="username"
                type="text"
                value={username}
                onChange={(e) => setUsername(e.target.value)}
                placeholder="请输入用户名"
                autoComplete="username"
                disabled={loading}
                className={inputClass}
              />
            </div>

            {/* 新增：手机号 */}
            {mode === "register" && (
              <div className="mb-4">
                <label htmlFor="phone" className={labelClass}>
                  手机号
                </label>

                <input
                  id="phone"
                  type="tel"
                  value={phone}
                  onChange={(e) => setPhone(e.target.value)}
                  placeholder="请输入手机号"
                  autoComplete="tel"
                  maxLength={11}
                  disabled={loading}
                  className={inputClass}
                />
              </div>
            )}

            {/* 新增：邮箱 */}
            {mode === "register" && (
              <div className="mb-4">
                <label htmlFor="email" className={labelClass}>
                  邮箱
                </label>

                <input
                  id="email"
                  type="email"
                  value={email}
                  onChange={(e) => setEmail(e.target.value)}
                  placeholder="请输入邮箱地址"
                  autoComplete="email"
                  disabled={loading}
                  className={inputClass}
                />
              </div>
            )}

            {/* 密码 */}
            <div className="mb-5">
              <label htmlFor="password" className={labelClass}>
                密码
              </label>

              <input
                id="password"
                type="password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                placeholder="请输入密码"
                autoComplete={
                  mode === "register"
                    ? "new-password"
                    : "current-password"
                }
                disabled={loading}
                className={inputClass}
              />
            </div>

            {/* 错误 / 成功提示 */}
            {message && (
              <div
                role={isError ? "alert" : "status"}
                className={`mb-4 border px-4 py-3 text-sm ${
                  isError
                    ? "border-red-200 bg-red-50 text-red-600"
                    : "border-blue-200 bg-blue-50 text-blue-700"
                }`}
              >
                {message}
              </div>
            )}

            {/* 提交按钮 */}
            <button
              type="submit"
              disabled={loading}
              className="h-[60px] w-full bg-[#405a72] text-white tracking-widest transition hover:bg-[#344e65] disabled:opacity-60"
            >
              {loading
                ? "请稍候..."
                : mode === "login"
                  ? "登 录"
                  : "注 册"}
            </button>
          </form>

          {/* 底部切换 */}
          <div className="mt-7 text-center text-sm text-[#8a96a0]">
            {mode === "login" ? (
              <>
                还没有账号？
                <button
                  type="button"
                  onClick={() => switchMode("register")}
                  className="ml-2 text-[#405a72] hover:underline"
                >
                  立即注册
                </button>
              </>
            ) : (
              <>
                已有账号？
                <button
                  type="button"
                  onClick={() => switchMode("login")}
                  className="ml-2 text-[#405a72] hover:underline"
                >
                  立即登录
                </button>
              </>
            )}
          </div>

          <p className="mt-8 text-center text-[11px] tracking-widest text-[#a4afb8]">
            OAuth2 · JWT Authentication
          </p>
        </div>
      </div>
    </div>
  );
}
